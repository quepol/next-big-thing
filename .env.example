# Copy to .env and fill in. The same names are GitHub Actions secrets (keys) and variables (users).
LASTFM_API_KEY=
TICKETMASTER_API_KEY=
# Optional: adds the shows you've logged as attended to your taste.
SETLISTFM_API_KEY=
# Your usernames. SETLISTFM_USER defaults to LASTFM_USER.
LASTFM_USER=
SETLISTFM_USER=
